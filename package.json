{
  "name": "dsh-monaco",
  "version": "0.1.0",
  "type": "module",
  "description": "Monaco editor inside the DSH right sidebar: it takes over the file preview for text and code files, edits in place, saves with a version guard, and exposes a language/theme extension API to other plugins.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config tsdown.client.config.mjs && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "prepack": "npm run build"
  },
  "license": "LGPL-3.0-only",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "monaco",
    "editor",
    "code-editor"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
